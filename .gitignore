# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- node ----
node_modules/
.next/
out/
*.tsbuildinfo

# ---- env ----
.env
.env.local
.env.*.local

# ---- data ----
# Raw source files are NOT vendored: they are public but large, and the
# licence is "redistribute by reference". `make data` re-downloads them.
data/raw/**
!data/raw/README.md
# Intermediate extraction caches (regenerable in one command).
data/processed/_*.parquet
data/processed/_*.json

# ---- artefacts ----
*.log
.DS_Store

# Playwright
apps/web/test-results/
apps/web/playwright-report/

# The static snapshot IS committed: a Git-driven Vercel build has no way
# to run the Python pipeline, so the recording has to be in the tree.
# Regenerate with `make snapshot`.

# Vercel
.vercel/
apps/web/.vercel/
