# ---- EcoTwin AI :: configuration -------------------------------------------
# Copy to `.env` and adjust. Every value has a working default; nothing here is
# a secret, because the prototype talks to no authenticated service.

# ---- backend ----
# Public demo mode: prefer precomputed results, never start a long job.
ECOTWIN_DEMO_MODE=true
# Interview mode: curated data, stable scenarios, no experimental surface.
ECOTWIN_INTERVIEW_MODE=true
# Comma-separated browser origins allowed to call the API.
ECOTWIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ECOTWIN_LOG_LEVEL=INFO

# Base URL of a BOPTEST REST instance. Leave empty to use the EcoTwin RC
# engine; the UI reports whichever actually answered and never mislabels one
# as the other.
#   docker compose --profile boptest up
#   ECOTWIN_BOPTEST_URL=http://boptest:5000
ECOTWIN_BOPTEST_URL=

# Repository root override. Only needed if the app runs from outside the repo.
# ECOTWIN_ROOT=/app

# ---- frontend ----
# The URL the BROWSER uses to reach the API. Next.js inlines NEXT_PUBLIC_* at
# build time, so a compose service name will not work here.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---- local engineering mode ----
# BOPTEST_IMAGE=ghcr.io/ibpsa/boptest-service:latest
